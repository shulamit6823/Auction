<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/logs/nlog-internal.log">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- Every line: time | level | RequestId (empty outside a request) | logger | message | exception -->
  <variable name="lineLayout"
            value="${longdate} | ${level:uppercase=true:padding=-5} | ${scopeproperty:RequestId:whenEmpty=-} | ${logger:shortName=true} | ${message}${onexception:inner=${newline}${exception:format=tostring}}" />

  <targets>
    <!-- One file per day, in the logs folder next to the running app (bin/Debug/net6.0/logs). -->
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/auction-${shortdate}.log"
            layout="${lineLayout}"
            maxArchiveDays="14" />

    <target xsi:type="Console" name="console" layout="${lineLayout}" />
  </targets>

  <rules>
    <!-- Keep the "Now listening on..." startup lines. -->
    <logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="file,console" final="true" />
    <!-- Framework noise (ASP.NET, EF Core SQL): only warnings and errors. -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <!-- Our code. -->
    <logger name="*" minlevel="Info" writeTo="file,console" />
  </rules>
</nlog>
